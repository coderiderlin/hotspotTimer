/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  background-color: #f8fafc;
  transition: background-color 0.3s ease;
}

.container.dark {
  background-color: #0f172a;
}

/* Header */
.header {
  height: 90rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-bottom: 2rpx solid #f1f5f9;
}

.container.dark .header {
  background: #1e293b;
  border-bottom-color: #334155;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.logo-icon {
  font-size: 40rpx;
}

.app-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #ff4757;
  letter-spacing: 1rpx;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #f1f5f9;
  color: #475569;
}

.container.dark .action-btn {
  background: #334155;
  color: #cbd5e1;
}

.theme-btn {
  font-size: 30rpx;
  padding: 4rpx 12rpx;
}

/* Queue Section (Top Half) */
.queue-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 16rpx 20rpx 8rpx;
  overflow: hidden;
}

.section-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bar-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #334155;
}

.container.dark .bar-title {
  color: #cbd5e1;
}

.bar-count {
  font-size: 22rpx;
  color: #94a3b8;
  margin-left: 8rpx;
}

.bar-badge {
  font-size: 20rpx;
  color: #10b981;
  background: #ecfdf5;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 700;
}

.queue-scroll {
  flex: 1;
  height: 100%;
}

.empty-queue {
  height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx dashed #cbd5e1;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.6);
  margin-top: 10rpx;
}

.container.dark .empty-queue {
  border-color: #334155;
  background: rgba(30, 41, 59, 0.4);
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #64748b;
}

.empty-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* Queue Card */
.queue-card-wrap {
  margin-bottom: 14rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.04);
}

.movable-area {
  width: 100%;
  height: 120rpx;
  background: #ef4444;
}

.movable-view {
  width: 100%;
  height: 120rpx;
  z-index: 10;
}

.del-btn {
  position: absolute;
  right: 0;
  top: 0;
  width: 140rpx;
  height: 120rpx;
  background: #ef4444;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  z-index: 1;
}

.card-content {
  width: 100%;
  height: 100%;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 4rpx solid #e2e8f0;
  border-radius: 24rpx;
  position: relative;
}

.container.dark .card-content {
  background: #1e293b;
  border-color: #334155;
}

.card-content.done {
  background: #ecfdf5;
  border-color: #10b981;
}

.container.dark .card-content.done {
  background: rgba(16, 185, 129, 0.15);
  border-color: #059669;
}

.card-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 2;
}

.card-icon {
  font-size: 44rpx;
}

.card-info {
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #1e293b;
}

.container.dark .card-name {
  color: #f8fafc;
}

.card-time-total {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

.card-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  z-index: 2;
}

.time-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.countdown {
  font-size: 38rpx;
  font-weight: 900;
  color: #ff4757;
  font-family: monospace;
}

.countdown.done-text {
  color: #10b981;
}

.card-status {
  font-size: 18rpx;
  color: #64748b;
  font-weight: 700;
}

.container.dark .card-status {
  color: #94a3b8;
}

.btn-fish {
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #10b981;
  color: #ffffff;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.progress-bg {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 6rpx;
  background: #ff4757;
  border-radius: 3rpx;
  transition: width 0.3s linear;
}

.progress-bg.done-bg {
  background: #10b981;
}

/* Category Section */
.category-section {
  height: 80rpx;
  background: #ffffff;
  border-top: 2rpx solid #f1f5f9;
  border-bottom: 2rpx solid #f1f5f9;
}

.container.dark .category-section {
  background: #1e293b;
  border-color: #334155;
}

.category-scroll {
  height: 100%;
  white-space: nowrap;
  padding: 0 12rpx;
}

.cat-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  margin: 10rpx 6rpx;
  border-radius: 24rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  font-weight: 800;
  color: #64748b;
}

.container.dark .cat-item {
  background: #334155;
  color: #94a3b8;
}

.cat-item.active {
  background: #ff4757;
  color: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(255, 71, 87, 0.3);
}

/* Food Grid Section (Bottom Half) */
.food-section {
  height: 520rpx;
  background: #ffffff;
  padding: 16rpx 16rpx 30rpx;
}

.container.dark .food-section {
  background: #1e293b;
}

.food-scroll {
  height: 100%;
}

.food-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.food-card {
  width: calc(33.333% - 10rpx);
  padding: 14rpx 10rpx 12rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 3rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  transition: transform 0.1s ease;
}

.container.dark .food-card {
  background: #0f172a;
  border-color: #334155;
}

.food-card:active {
  transform: scale(0.95);
}

.food-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 18rpx;
  font-weight: 900;
  color: #b45309;
  background: #fef3c7;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.container.dark .food-badge {
  background: #78350f;
  color: #fde68a;
}

.food-icon {
  font-size: 46rpx;
  margin-top: 6rpx;
}

.food-name {
  font-size: 22rpx;
  font-weight: 800;
  color: #1e293b;
  margin-top: 6rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 90%;
}

.container.dark .food-name {
  color: #f8fafc;
}

.food-tip {
  font-size: 16rpx;
  color: #94a3b8;
  margin-top: 2rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 95%;
}
